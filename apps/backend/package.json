{
  "name": "@eduviet/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/assets dist/",
    "start": "node dist/main.js",
    "start:prod": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eduviet/email-templates": "workspace:*",
    "@eduviet/redis": "workspace:*",
    "@eduviet/shared-types": "workspace:*",
    "@eduviet/storage": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/csrf-protection": "^7.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.3",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.1",
    "@prisma/client": "^6.2.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.34.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "minio": "^8.0.5",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.18.0",
    "pino": "^9.6.0",
    "sanitize-html": "^2.13.0",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "@types/sanitize-html": "^2.13.0",
    "@vitest/coverage-v8": "^3.0.2",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}

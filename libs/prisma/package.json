{
  "name": "@eduviet/prisma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "migrate:dev": "prisma migrate dev --schema=./schema.prisma",
    "migrate:create": "prisma migrate dev --schema=./schema.prisma --create-only",
    "migrate:deploy": "prisma migrate deploy --schema=./schema.prisma",
    "generate": "prisma generate --schema=./schema.prisma",
    "seed": "tsx src/seed.ts",
    "reset": "prisma migrate reset --schema=./schema.prisma --force",
    "studio": "prisma studio --schema=./schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "tsx": "^4.19.2"
  }
}
